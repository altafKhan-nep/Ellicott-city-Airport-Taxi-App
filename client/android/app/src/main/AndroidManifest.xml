<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Keeps publishing the driver's position while the app is
             backgrounded or the screen is locked. Started when the driver goes
             on duty or accepts a ride, stopped when the trip ends. -->
        <service
            android:name=".DriverLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location powers "use my location", the booking map, live driver
         tracking and the driver's own position broadcast. The app reads
         navigator.geolocation directly; Capacitor's WebChromeClient turns the
         WebView's permission prompt into the runtime request, but it can only
         succeed if the permission is declared here. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- BACKGROUND LOCATION (Play Store declaration)
         Justification: a passenger must be able to follow their driver's
         actual position for the whole of a trip, including while their own
         screen is locked and the app is backgrounded. Without this the
         driver's marker freezes mid-ride. It is requested only while the
         driver is on duty or mid-ride, and the service is stopped the moment
         the trip ends, so collection is not continuous in the background.
         The foreground service shows a permanent, low-priority "On an active
         trip" notification so the behaviour is always visible to the driver. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Android 14+ requires an explicit foreground-service type, and the
         matching permission, before a location service may run in the
         background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 13+ will not display the foreground-service notification
         without this, and a service whose notification is suppressed is killed
         more aggressively. Requested only alongside the service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The driver screen has to keep working on a phone with no GPS fix, so
         location is declared as not-required rather than blocking install. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
